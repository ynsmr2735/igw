# Supabase Postgres connection string (server-side only, never exposed to the browser).
# Supabase -> Connect -> "Transaction pooler" (port 6543) works well on Vercel.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Secret used to sign session cookies. At least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-string

# Optional: Supabase's CA certificate (Database -> SSL) to verify the TLS certificate.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
